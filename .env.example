# Supabase 대시보드 > Project Settings > API Keys 에서 복사합니다.
# 이 파일을 .env.local 로 복사해 채우세요. .env.local 은 커밋되지 않습니다.

# Project Settings > Data API 의 Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠️ 비밀 키입니다. RLS를 우회하므로 절대 브라우저로 나가면 안 됩니다.
#    NEXT_PUBLIC_ 접두사를 붙이지 마세요. 서버에서만 읽습니다.
#
# 최근 만든 프로젝트: API Keys 탭의 secret 키 (sb_secret_... 로 시작)
# 예전에 만든 프로젝트: Legacy API Keys 탭의 service_role 키 (eyJ... 로 시작)
# 둘 다 같은 service_role 권한이라 어느 쪽이든 그대로 넣으면 됩니다.
SUPABASE_SERVICE_ROLE_KEY=
